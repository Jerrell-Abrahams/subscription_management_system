PORT=3000

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

JWT_SECRET=
JWT_EXPIRES_IN=7d
# Allowed CORS origins for the dashboard, comma-separated (see src/server.js).
# On Vercel: https://admin.complexai.co.za plus the project's .vercel.app URL.
ADMIN_ORIGIN=http://localhost:5173

# Set on Vercel; the platform auto-sends it as `Authorization: Bearer <value>`
# when it hits the cron route, so any random string works.
CRON_SECRET=

# Used to send the onboarding email when an admin creates a user (see src/lib/email.js)
RESEND_API_KEY=

# Google Cloud API key with "Places API (New)" enabled -- powers the lead finder
# (POST /api/leads/search). Server-side only; each search is a billable request.
GOOGLE_PLACES_API_KEY=

# Searches allowed per calendar month before /api/leads/search starts refusing.
# Defaults to 1000, Google's free Text Search Enterprise allowance -- raise it only to
# deliberately pay for searches beyond the free tier.
PLACES_SEARCH_CAP=1000

# --- Invoice/receipt PDFs (src/lib/invoicePdf.js) -----------------------------
# Nothing to configure here. Business name, address, phone, email, tax number and
# banking details live in the admin dashboard under Settings (src/db/settings.sql) --
# changing a phone number shouldn't need a redeploy.
#
# The logo and the two typefaces are build assets rather than settings: assets/logo.svg
# and assets/fonts/*.ttf, shipped to Vercel via the includeFiles rule in vercel.json.

# --- Payfast import (src/lib/payfast.js) --------------------------------------
# Pulls transactions into the Finance ledger. Run src/db/payfast.sql first.
#
# NOT your merchant key -- the API never uses that one. The passphrase is a value you
# set yourself under Settings > Security in the Payfast dashboard; without one set on
# the account, every API call is rejected however correct the request is. Live and
# sandbox have different merchant ids AND different passphrases.
#
# Leave both blank to keep the Finance tab manual-only: the nightly sync logs and moves
# on, and the Sync button says what's missing.
PAYFAST_MERCHANT_ID=
PAYFAST_PASSPHRASE=
# Only to test against the sandbox: https://api.sandbox.payfast.co.za
PAYFAST_API_BASE=

# RSA private key for signing offline license certificates (RS256), separate
# from JWT_SECRET above. Generate with:
#   node -e "const{generateKeyPairSync}=require('crypto');const{publicKey,privateKey}=generateKeyPairSync('rsa',{modulusLength:2048,publicKeyEncoding:{type:'spki',format:'pem'},privateKeyEncoding:{type:'pkcs8',format:'pem'}});console.log(privateKey);console.log(publicKey)"
# Paste the private key here (multiline, quoted) and embed the printed public
# key as LICENSE_CERT_PUBLIC_KEY in the consuming app (e.g. the POS).
LICENSE_CERT_PRIVATE_KEY=2