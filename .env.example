PORT=3000

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

JWT_SECRET=
JWT_EXPIRES_IN=7d
# Allowed CORS origins for the dashboard, comma-separated (see src/server.js).
# On Vercel: https://admin.complexai.co.za plus the project's .vercel.app URL.
ADMIN_ORIGIN=http://localhost:5173

# Set on Vercel; the platform auto-sends it as `Authorization: Bearer <value>`
# when it hits the cron route, so any random string works.
CRON_SECRET=

# Sends the daily digest from the cron (src/lib/email.js). No customer ever receives mail
# from this system, so an unverified resend.dev sender is fine -- it delivers to the Resend
# account owner, which is the only recipient there is.
RESEND_API_KEY=

# Where the daily digest lands. Must be the Resend account's own email until a domain is
# verified. Defaults to jerrellabrahams50@gmail.com if unset.
ADMIN_EMAIL=

# Google Cloud API key with "Places API (New)" enabled -- powers the lead finder
# (POST /api/leads/search). Server-side only; each search is a billable request.
GOOGLE_PLACES_API_KEY=

# Searches allowed per calendar month before /api/leads/search starts refusing.
# Defaults to 1000, Google's free Text Search Enterprise allowance -- raise it only to
# deliberately pay for searches beyond the free tier.
PLACES_SEARCH_CAP=1000

# --- Invoice/receipt PDFs (src/lib/invoicePdf.js) -----------------------------
# Nothing to configure here. Business name, address, phone, email, tax number and
# banking details live in the admin dashboard under Settings (src/db/settings.sql) --
# changing a phone number shouldn't need a redeploy.
#
# The logo and the two typefaces are build assets rather than settings: assets/logo.svg
# and assets/fonts/*.ttf, shipped to Vercel via the includeFiles rule in vercel.json.

# --- Paystack import (src/lib/paystack.js) ------------------------------------
# Pulls successful Paystack payments into the Finance ledger: the gross as money in, and
# Paystack's fee as a matching "Paystack fees" expense. Runs nightly off the cron route,
# plus the Sync button on the Finance tab.
#
# The SECRET key (sk_live_... or sk_test_...) from Settings > API Keys & Webhooks in the
# Paystack dashboard -- NOT the public pk_... key, which cannot list transactions. Server
# side only; it must never reach the admin build.
#
# No migration to run: the source/external_id columns and the unique index it dedupes on
# already exist, created by src/db/payfast.sql for the importer this replaces.
#
# Leave blank to keep the Finance tab manual-only: the nightly sync logs and moves on, and
# the Sync button says what's missing.
PAYSTACK_SECRET_KEY=
# Only to point at a mock server in a test; defaults to https://api.paystack.co
PAYSTACK_API_BASE=

# --- Offline license certificates ---------------------------------------------
# RSA private key for signing offline license certificates (RS256), separate
# from JWT_SECRET above. Generate with:
#   node -e "const{generateKeyPairSync}=require('crypto');const{publicKey,privateKey}=generateKeyPairSync('rsa',{modulusLength:2048,publicKeyEncoding:{type:'spki',format:'pem'},privateKeyEncoding:{type:'pkcs8',format:'pem'}});console.log(privateKey);console.log(publicKey)"
# Paste the private key here (multiline, quoted) and embed the printed public
# key as LICENSE_CERT_PUBLIC_KEY in the consuming app (e.g. the POS).
LICENSE_CERT_PRIVATE_KEY=2
# --- Document signature ---------------------------------------------------------
# Not an env var. Your handwritten signature lives at assets/signature.svg, committed
# alongside assets/logo.svg -- see the SIGNATURE comment in src/lib/pdfBase.js for why
# it is a file, not a secret. Drop a flat <path>-only SVG there (same shape the logo
# uses) and every generated contract picks it up; delete the file and the signature
# line goes back to ruled.

# --- QR codes (src/lib/qr.js) -------------------------------------------------
# The origin the printed QR codes point at. Every code encodes <QR_BASE_URL>/<code> and
# never the destination itself, so the target stays editable after the cards are printed.
#
# This must be a hostname aliased to THIS Vercel project -- vercel.json rewrites every path
# into Express, so the subdomain needs no routing config, but it does need the DNS record
# (CNAME `qr` in the Host Africa panel) and the domain added on the Vercel project.
# Defaults to https://qr.complexai.co.za.
QR_BASE_URL=

# QR Code Monkey needs no API key and there is nothing to configure. This only exists so a
# test can point at a mock server; defaults to https://api.qrcode-monkey.com.
QR_MONKEY_BASE=
